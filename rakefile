# frozen_string_literal: true

require 'rake'

desc 'do all the setup!'
task default: :brew do
  # .claude is handled separately: ~/.claude also holds Claude Code runtime state
  # (sessions/, projects/, history.jsonl), which a whole-directory link would rm -rf.
  dotfiles = Dir.glob('.*') - ['.git', '.gitmodules', '.', '..', '.gitignore', '.claude']
  symlink_files(ENV['HOME'], dotfiles)
  # Paths keep their '.claude/' prefix so they land inside the existing ~/.claude.
  # Tracked files only, matching .gitignore: settings.local.json is per-checkout state.
  symlink_files(ENV['HOME'], `git ls-files -z .claude`.split("\x00"))
  xdg_config = ENV['XDG_CONFIG_HOME'] || File.join(ENV['HOME'], '.config')
  symlink_files(File.join(xdg_config, 'git'), ['ignore'])
  symlink_files(xdg_config, ['nvim', 'ghostty'])
end

desc 'install Homebrew dependencies from the Brewfile'
task :brew do
  install_brew_dependencies
end

def install_brew_dependencies
  unless system('command -v brew > /dev/null 2>&1')
    puts ' => skipping brew bundle (Homebrew not installed)'
    return
  end

  brewfile = File.join(File.dirname(__FILE__), 'Brewfile')
  puts ' => installing Homebrew dependencies'
  system('brew', 'bundle', "--file=#{brewfile}") || abort('brew bundle failed')
end

def symlink_files(destination, files)
  @destination = destination

  files.each do |file|
    if file_identical?(file)    then skip_identical_file(file)
    elsif replace_all_files?    then replace_file(file)
    elsif file_missing?(file)   then link_file(file)
    else
      prompt_to_link_file(file)
    end
  end
end

# FILE CHECKS
def file_exists?(file)
  File.exist?("#{@destination}/#{file}")
end

# File.exist? follows the link, so a symlink whose target moved away (repo renamed, file
# deleted upstream) reads as missing and then ln_s aborts the task with EEXIST.
def file_missing?(file)
  !file_exists?(file) && !File.symlink?(File.join(@destination, file))
end

def file_identical?(file)
  File.identical? file, File.join(@destination, file.to_s)
end

def replace_all_files?
  @replace_all == true
end

# FILE ACTIONS
def prompt_to_link_file(file)
  print "overwrite? #{@destination}/#{file} [ynaq]  "
  case $stdin.gets.chomp
  when 'y' then replace_file(file)
  when 'a' then replace_all(file)
  when 'q' then exit
  else skip_file(file)
  end
end

def link_file(file)
  puts " => symlinking #{file}"
  directory = File.dirname(__FILE__)
  target = File.join(@destination, file)
  FileUtils.mkdir_p(File.dirname(target))
  FileUtils.ln_s(File.join(directory, file), target, force: true)
end

def replace_file(file)
  FileUtils.rm_rf(File.join(@destination, file))
  link_file(file)
end

def replace_all(file)
  @replace_all = true
  replace_file(file)
end

def skip_file(file)
  puts " => skipping #{@destination}/#{file}"
end

def skip_identical_file(file)
  puts " => skipping identical #{@destination}/#{file}"
end
