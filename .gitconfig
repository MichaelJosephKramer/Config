[alias]
  alias        = !git config -l | grep alias | cut -c 7- | sort
  amend        = commit --amend --no-edit
  br           = branch
  branch-name  = !git rev-parse --abbrev-ref HEAD
  brl          = !git for-each-ref --color=always --sort=-committerdate refs/heads --format='%(HEAD)%(color:yellow)%(refname:short)|%(color:bold green)%(committerdate:relative)|%(color:red)%(objectname:short)|%(color:blue)%(subject)|%(color:magenta)%(authorname)%(color:reset)'|column -ts'|'
  ci           = commit -v
  co           = checkout
  cob          = checkout -b
  com          = "!f() { git checkout $(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@' || echo main); }; f"
  fix          = "!f() { ${EDITOR} $(git diff --name-only); }; f"
  flush        = "!f() { default=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@') || default=main; git branch --merged $default | grep -v $default | xargs git branch -d && git remote prune origin; }; f"
  new          = !git pull origin $(git branch-name)
  pub          = !git push origin $(git branch-name)
  hist         = log --pretty=format:\"%Cred%h%Creset %ad | %s%d %C(bold blue)[%an]%Creset %Cgreen(%cr)%Creset\" --graph --date=short
  last         = !git hist -1
  lgrep        = grep --heading --break
  me           = !git hist --author=$(git config user.email)
  sha          = !git rev-parse --short HEAD | tr -d '\n' | pbcopy
  st           = status
  this         = !git init && git add . && git commit -m 'Initial commit'
  wip          = commit -am 'WIP'
[color]
  ui           = true
[core]
  autocrlf     = input
  editor       = nvim
  pager        = delta
[credential]
  helper       = osxkeychain
[interactive]
  diffFilter   = delta --color-only
[pull]
  rebase       = true
[user]
  name         = Michael Joseph Kramer
  email        = michael@sage.house
[init]
  defaultBranch = main
[branch]
  sort         = -committerdate
[delta]
  syntax-theme = tokyonight_night
  navigate     = true
  line-numbers = true
  minus-style                   = syntax "#4a272f"
  minus-non-emph-style          = syntax "#4a272f"
  minus-emph-style              = syntax "#713137"
  minus-empty-line-marker-style = syntax "#4a272f"
  line-numbers-minus-style      = "#914c54"
  plus-style                    = syntax "#243e4a"
  plus-non-emph-style           = syntax "#243e4a"
  plus-emph-style               = syntax "#2c5a66"
  plus-empty-line-marker-style  = syntax "#243e4a"
  line-numbers-plus-style       = "#449dab"
  line-numbers-zero-style       = "#3b4261"
[diff]
  algorithm    = histogram
  colorMoved   = default
[fetch]
  prune        = true
[includeIf "gitdir:~/Code/"]
  path         = ~/.gitconfig-work
[grep]
  extendRegexp = true
  fullName     = true
  lineNumber   = true
[merge]
  conflictstyle = zdiff3
[push]
  autoSetupRemote = true
  followTags   = true
[rebase]
  autoSquash   = true
  autoStash    = true
[rerere]
  enabled      = true
[commit]
  verbose      = true
[column]
  ui           = auto
